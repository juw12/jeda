[
  {
    "id": "upc-ceng-beng",
    "faith": "khonghucu",
    "title": "Ceng Beng: ziarah makam leluhur",
    "summary": "Daftar persiapan ziarah dan sembahyang di makam atau rumah abu.",
    "timing": "Sekitar 4–5 April (umumnya ±10 hari).",
    "groups": [
      {
        "title": "Kebersihan makam",
        "items": [
          "Sapu, sikat, kain lap",
          "Gunting rumput / sabit kecil",
          "Cat dan kuas untuk tulisan nisan (bila perlu)",
          "Kantong sampah"
        ]
      },
      {
        "title": "Sembahyang",
        "items": [
          "Hio dan korek",
          "Lilin merah",
          "Buah (mis. jeruk, apel, pisang)",
          "Kue / makanan kesukaan leluhur",
          "Teh atau arak dan cawan kecil",
          "Persembahan untuk Toapekong Tanah (bila ada altar di makam)"
        ]
      },
      {
        "title": "Kertas sembahyang (sesuai adat keluarga)",
        "items": [
          "Kim cua / gin cua",
          "Kertas untuk ditaruh di atas makam (tradisi Hokkien)",
          "Wadah aman untuk membakar"
        ]
      },
      {
        "title": "Lain-lain",
        "items": [
          "Air minum dan payung/topi",
          "Tikar",
          "Daftar nama leluhur dan lokasi makam"
        ]
      }
    ],
    "steps": [
      "Berangkat bersama keluarga; yang tertua memimpin.",
      "Bersihkan makam dan perbaiki tulisan bila perlu.",
      "Sembahyang kepada Toapekong Tanah (bila ada).",
      "Tata persembahan, nyalakan lilin dan hio, soja/pai bergantian dari yang tertua.",
      "Bakar kertas sembahyang di wadah aman sesuai adat dan aturan makam.",
      "Rapikan kembali dan bawa pulang sampah."
    ],
    "dos": [
      "Ajak anak-anak dan ceritakan tentang leluhur.",
      "Patuhi aturan pengelola pemakaman tentang pembakaran."
    ],
    "donts": [
      "Membakar kertas sembarangan di dekat makam lain.",
      "Meninggalkan sampah dan sisa makanan."
    ],
    "variations": [
      {
        "label": "Hokkien",
        "text": "Lazim menaruh kertas di atas makam."
      },
      {
        "label": "Hakka",
        "text": "Ziarah besar dapat dilakukan sebelum hari Ceng Beng; tanyakan tetua."
      }
    ],
    "related": [
      "khc-hariraya-cengbeng",
      "khc-ibadah-leluhur"
    ],
    "holidays": [
      "ceng-beng"
    ],
